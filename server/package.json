{
  "name": "leadway-estate-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:deploy": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "node --env-file-if-exists=.env.test tests/run.js",
    "db:demo": "node --env-file-if-exists=.env prisma/demo.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.2"
  }
}
