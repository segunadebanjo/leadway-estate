# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://leadway:leadway@localhost:5432/leadway_estate
# Long random string (32+ chars): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- App ----------------------------------------------------------------------
PORT=4000
# Public URL of the app (used in emails, receipts and the Paystack callback)
APP_URL=http://localhost:5173
SESSION_HOURS=12
ESTATE_NAME=Leadway Estate
ESTATE_ADDRESS=Mowe, Ogun State
# Month (1-12) in which the Annual Development Fee is billed
ANNUAL_BILLING_MONTH=1
# Days after the invoice date that a bill falls due
PAYMENT_TERMS_DAYS=14
# Set to false on all but one instance if you run several
ENABLE_SCHEDULER=true
# Only for documents uploaded before v2.1 (new ones are stored in the database)
UPLOAD_DIR=uploads

# --- Paystack -------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (SMTP) ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Leadway Estate <no-reply@leadwayestate.ng>

# --- SMS (Termii) ---------------------------------------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=Leadway

# --- Seed (optional) ------------------------------------------------------------
# SEED_ADMIN_EMAIL=admin@leadwayestate.ng
# SEED_ADMIN_PASSWORD=   (if unset, a random one is printed once)
