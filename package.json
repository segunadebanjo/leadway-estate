{
  "name": "leadway-estate",
  "version": "2.0.0",
  "private": true,
  "description": "Residential estate association management – Leadway Estate, Mowe, Ogun State",
  "scripts": {
    "local": "node scripts/local.mjs",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:migrate": "npm --prefix server run db:deploy",
    "db:seed": "npm --prefix server run db:seed",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "embedded-postgres": "17.10.0-beta.17"
  }
}
